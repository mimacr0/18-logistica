<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sat_repair_add_parts_wizard_view_form" model="ir.ui.view">
        <field name="name">rma.repair.add.parts.wizard.form</field>
        <field name="model">rma.repair.add.parts.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Spare Parts">
                <sheet>
                    <group>
                        <field name="repair_id" invisible="1"/>
                        <field name="owner_id" invisible="1"/>
                    </group>
                    <p class="text-muted mb-2">
                        Choose a spare part and the source location (default: repair department warehouse). Available quantity is the total across all quants at that location.
                    </p>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="product_id"
                                   domain="[('product_tmpl_id.is_spare_parts', '=', True), ('type', '!=', 'service')]"
                                   options="{'no_create': True}"/>
                            <field name="allowed_location_ids" column_invisible="1"/>
                            <field name="location_id"
                                   domain="[('id', 'in', allowed_location_ids)]"
                                   options="{'no_create': True}"/>
                            <field name="qty_available" string="Available" readonly="1"/>
                            <field name="qty_to_add" string="Qty to add"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_add_parts" string="Add Parts" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sat_repair_add_parts_wizard" model="ir.actions.act_window">
        <field name="name">Add Spare Parts</field>
        <field name="res_model">rma.repair.add.parts.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
