<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_sat_repair" model="ir.sequence">
            <field name="name">RMA Repair Sequence</field>
            <field name="code">rma.repair.sequence</field>
            <field name="prefix">REP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_rma_harvest_operation" model="ir.sequence">
            <field name="name">RMA Harvest Operation</field>
            <field name="code">rma.harvest.operation</field>
            <field name="prefix">HRV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
