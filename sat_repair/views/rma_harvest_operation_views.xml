<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rma_harvest_operation_tree" model="ir.ui.view">
        <field name="name">rma.harvest.operation.list</field>
        <field name="model">rma.harvest.operation</field>
        <field name="arch" type="xml">
            <list string="Harvest operations">
                <field name="name"/>
                <field name="create_date"/>
                <field name="rma_unit_id"/>
                <field name="location_id"/>
                <field name="line_count"/>
            </list>
        </field>
    </record>

    <record id="view_rma_harvest_operation_form" model="ir.ui.view">
        <field name="name">rma.harvest.operation.form</field>
        <field name="model">rma.harvest.operation</field>
        <field name="arch" type="xml">
            <form string="Harvest operation">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="rma_unit_id"/>
                        </group>
                        <group>
                            <field name="location_id"/>
                            <field name="owner_id"/>
                            <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Spare parts obtained" name="lines">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rma_harvest_operation" model="ir.actions.act_window">
        <field name="name">Harvest operations</field>
        <field name="res_model">rma.harvest.operation</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_rma_harvest_operation_from_unit" model="ir.actions.act_window">
        <field name="name">Harvest operations</field>
        <field name="res_model">rma.harvest.operation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('rma_unit_id', '=', active_id)]</field>
        <field name="context">{'default_rma_unit_id': active_id}</field>
    </record>

    <record id="view_rma_unit_form_inherit_harvest_repair" model="ir.ui.view">
        <field name="name">rma.unit.form.inherit.harvest.repair</field>
        <field name="model">rma.unit</field>
        <field name="inherit_id" ref="rma_inventory.view_rma_unit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="harvest_operation_count" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="action"
                        name="%(sat_repair.action_rma_harvest_operation_from_unit)d"
                        icon="fa-cubes"
                        invisible="harvest_operation_count == 0">
                    <field name="harvest_operation_count" widget="statinfo" string="Harvests"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='notes']" position="after">
                <page string="Harvests" name="harvest_operations"
                      invisible="harvest_operation_count == 0">
                    <field name="harvest_operation_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="create_date"/>
                            <field name="location_id"/>
                            <field name="line_count"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
