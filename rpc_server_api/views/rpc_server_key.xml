<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="rpc_server_key_search" model="ir.ui.view">
            <field name="name">rpc.server.key.search</field>
            <field name="model">rpc.server.key</field>
            <field name="arch" type="xml">
                <search string="Keys">
                    <field name="name" string="Keys" filter_domain="['|', ('name', 'ilike', self), ('client_user', 'ilike', self)]"/>
                </search>
            </field>
        </record>

        <record id="rpc_server_key_list" model="ir.ui.view">
            <field name="name">rpc.server.key.list</field>
            <field name="model">rpc.server.key</field>
            <field name="arch" type="xml">
                <list string="Keys">
                    <field name="name"/>
                    <field name="client_user"/>
                </list>
            </field>
        </record>

        <record id="rpc_server_key_form" model="ir.ui.view">
            <field name="name">rpc.server.key.form</field>
            <field name="model">rpc.server.key</field>
            <field name="arch" type="xml">
                <form string="Keys">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <div class="d-flex">
                                    <field class="text-break" name="name" placeholder="e.g. Key"/>
                                </div>
                            </h1>
                        </div>
                        <group>
                            <field name="public_key_file" filename="public_key_filename"/>
                            <field name="public_key_filename" invisible="1"/>
                            <field name="client_user"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="rpc_server_key_action" model="ir.actions.act_window">
            <field name="name">Keys</field>
            <field name="res_model">rpc.server.key</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
