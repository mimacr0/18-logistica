<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="rpc_server_action_search" model="ir.ui.view">
            <field name="name">rpc.server.action.search</field>
            <field name="model">rpc.server.action</field>
            <field name="arch" type="xml">
                <search string="Actions">
                    <field name="name" string="Actions" filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"/>
                </search>
            </field>
        </record>

        <record id="rpc_server_action_list" model="ir.ui.view">
            <field name="name">rpc.server.action.list</field>
            <field name="model">rpc.server.action</field>
            <field name="arch" type="xml">
                <list string="Actions">
                    <field name="name"/>
                    <field name="reference"/>
                </list>
            </field>
        </record>

        <record id="rpc_server_action_form" model="ir.ui.view">
            <field name="name">rpc.server.action.form</field>
            <field name="model">rpc.server.action</field>
            <field name="arch" type="xml">
                <form string="Actions">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <div class="d-flex">
                                    <field class="text-break" name="name" placeholder="e.g. Action"/>
                                </div>
                            </h1>
                        </div>
                        <group>
                            <field name="reference"/>
                            <field name="action" widget="ace" options="{'mode': 'python'}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="rpc_server_action_action" model="ir.actions.act_window">
            <field name="name">Actions</field>
            <field name="res_model">rpc.server.action</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
