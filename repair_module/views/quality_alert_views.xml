<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_module_quality_alert_view_form" model="ir.ui.view">
        <field name="name">repair.module.quality.alert.view.form</field>
        <field name="model">quality.alert</field>
        <field name="inherit_id" ref="quality_control.quality_alert_view_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_create_move_to_repair"
                        type="object"
                        string="Move To Repair"
                        class="btn-primary"/>
            </header>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="open_stock_picking" type="object" class="oe_stat_button" icon="fa-bell" invisible="stock_picking_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="stock_picking_count"/></span>
                        <span class="o_stat_text">Stock Picking</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='title']" position="after">
                <field name="account_partner_id"/>
            </xpath> 
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="quantity"></field>
            </xpath>
            <xpath expr="//notebook/page[@name='miscellaneous']" position="before">
                <page string="Repair" name="repair_orders">
                    <field name="repair_order_ids" widget="one2many"/>
                </page>
            </xpath> 
        </field>
    </record>
</odoo>