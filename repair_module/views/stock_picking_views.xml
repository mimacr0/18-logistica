<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_module_view_picking_form" model="ir.ui.view">
        <field name="name">repair.module.view.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_create_repair_order"
                        type="object"
                        string="Create Repair 1"
                        class="btn-primary"
                        invisible="state != 'done' or picking_type_barcode != 'move_repair' or repair_ids" />
            </header>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="maintenance_type" invisible="picking_type_barcode != 'move_repair'"/>
            </xpath>
        </field>
    </record>
</odoo>