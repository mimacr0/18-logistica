<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_module_view_repair_order_form" model="ir.ui.view">
        <field name="name">repair.module.view.repair.order.form</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

               
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="open_quality_check" type="object" class="oe_stat_button" icon="fa-bell">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">1</span>
                        <span class="o_stat_text">Quality Check</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="account_partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
