<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_module_view_repair_order_form" model="ir.ui.view">
        <field name="name">repair.module.view.repair.order.form</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <header position="inside">
                <button name="action_batch_set_technician"
                    type="object"
                    string="Set Technician"
                    class="btn-secondary" invisible="state not in ['draft', 'confirmed']" groups="logistics_security.group_repair_manager"/>
            </header>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="account_partner_id" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="readonly">True</attribute>
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="readonly">True</attribute>
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='product_qty']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>
            <xpath expr="//field[@name='picking_id']" position="attributes">
                <attribute name="readonly">True</attribute>
                <attribute name="invisible">True</attribute>
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='schedule_date']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <div style="display: flex; align-items: flex-start; font-size: 1.2rem;" class="float-end">
                    <field name="maintenance_type" widget="badge"/>
                </div>
            </xpath>

            <!-- Se sustituye de la vista principal para ponerlo en una página como información adicional-->
            <xpath expr="//field[@name='user_id']" position="replace">
                <field name="technician_id" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
            </xpath> 
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="lifecycle_state" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" readonly="state != 'under_repair'"/>
            </xpath>
            <xpath expr="//notebook/page[@name='parts']" position="before">
                <page string="Diagnosis" name="diagnosis_page">
                    <group>
                        <field name="description" readonly="state != 'under_repair'"/>
                    </group>
                    <group>
                        <field name="diagnosis_ids" readonly="state != 'under_repair'" options="{'no_create': True, 'no_edit': True}"/>
                    </group>
                </page>
                <page string="Result" name="result_page">
                    <group>
                        <field name="result_ids" readonly="state != 'under_repair'" options="{'no_create': True, 'no_edit': True}"/>
                    </group>
                    <group>
                        <field name="move_ids" readonly="state != 'under_repair'"/>
                    </group>
                </page>
            </xpath>

            <xpath expr="//notebook/page[@name='page_miscellaneous']/group" position="replace">
                <group string="Tracking History">
                    <group string="General Information">
                        <field name="user_id" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                        <field name="confirm_date" readonly="1"/>
                    </group>
                    <group string="Assigned">
                        <field name="assigned_date" readonly="1"/>
                        <field name="assigned_user_id" readonly="1"/>
                    </group>
                    <group string="In Progress">
                        <field name="in_progress_date" readonly="1"/>
                        <field name="in_progress_user_id" readonly="1"/>
                    </group>
                    <group string="Done">
                        <field name="done_date" readonly="1"/>
                        <field name="done_user_id" readonly="1"/>
                    </group>
                </group>
                <group string="Movement Information">
                    <field name="repair_alert_id" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                    <field name="picking_type_id" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_repair_diagnosis" model="ir.actions.act_window">
        <field name="name">Repair Diagnostics</field>
        <field name="res_model">repair.diagnosis</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Manage possible fault diagnostics for electronic products.</p>
        </field>
    </record>

    <record id="action_repair_result" model="ir.actions.act_window">
        <field name="name">Repair Results</field>
        <field name="res_model">repair.result</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Manage possible repair results.</p>
        </field>
    </record>

    <record id="repair_module_view_repair_order_tree_inherit" model="ir.ui.view">
        <field name="name">repair.module.view.repair.order.tree.inherit</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="account_partner_id" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                <field name="lot_id" readonly="1" string="Reference" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//field[@name='schedule_date']" position="after">
                <field name="description" widget="html" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="optional">Hide</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="replace"/>
            <xpath expr="//field[@name='parts_availability']" position="attributes">
                <attribute name="optional">Hide</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_id']" position="replace"/>
            <xpath expr="//field[@name='state']" position="before">
                <field name="technician_id" widget="many2one_avatar_user" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>

                <field name="assigned_date" optional="hide" widget="datetime" readonly="1"/>
                <field name="assigned_user_id" optional="hide" widget="many2one_avatar_user" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                <field name="in_progress_date" optional="hide" widget="datetime" readonly="1"/>
                <field name="in_progress_user_id" optional="hide" widget="many2one_avatar_user" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                <field name="done_date"  optional="hide" widget="datetime" readonly="1"/>
                <field name="done_user_id" optional="hide" widget="many2one_avatar_user" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

    <record id="action_repair_set_technician_server" model="ir.actions.server">
        <field name="name">Set Technician</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="binding_model_id" ref="repair.model_repair_order"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_batch_set_technician()</field>
        <field name="groups_id" eval="[(4, ref('logistics_security.group_repair_manager'))]"/>
    </record>

</odoo>
