<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        Menu Security Overrides
        - Quality menu: Only accessible to After Sales Department
        - Repair menu: Only accessible to Repair Department
    -->

    <!-- Quality Menu - Restrict to After Sales Department -->
    <record id="quality_control.menu_quality_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('logistics_security.group_after_sales_user')])]"/>
    </record>

    <!-- Repair Menu - Restrict to Repair Department -->
    <record id="repair.menu_repair_order" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('logistics_security.group_repair_user')])]"/>
    </record>


    <record id="repair.repair_menu_config" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('logistics_security.group_repair_manager'))]"/>
    </record>
    <!-- Custom menu items -->
    <menuitem id="menu_repair_result"
              name="Results"
              parent="repair.repair_menu_config"
              action="action_repair_result"
              sequence="100"/>

    <menuitem id="menu_repair_diagnosis"
              name="Diagnostics"
              parent="repair.repair_menu_config"
              action="action_repair_diagnosis"
              sequence="120"/>
</odoo>
