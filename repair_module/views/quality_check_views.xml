<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_module_quality_check_view_form" model="ir.ui.view">
        <field name="name">repair.module.quality.check.view.form</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control.quality_check_view_form"/>
        <field name="arch" type="xml">
            <header position="inside">

                <button name="action_create_repair_order"
                        type="object"
                        string="Create Repair"
                        class="btn-primary"/>
            </header>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="open_repair_order" type="object" class="oe_stat_button" icon="fa-wrench" invisible="not repair_order_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">1</span>
                        <span class="o_stat_text">Repair order</span>
                    </div>
                </button>
            </xpath>


            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="is_repair_request"/>

                <field name="repair_order_id"/>
            </xpath>


        </field>
    </record>
</odoo>