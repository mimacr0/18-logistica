<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_module_view_production_lot_form" model="ir.ui.view">
        <field name="name">repair.module.view.production.lot.form</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='total_value']" position="before">
                <field name="lifecycle_state"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Repair Order" name="repair_info">
                    <group>
                        <field name="repair_order_id"/>
                    </group>
                    <group>
                        <group>
                            <field name="diagnosis_ids" widget="many2many_list" options="{'no_create': True, 'no_edit': True}" readonly="1"/>
                        </group>
                        <group>
                            <field name="result_ids" options="{'no_create': True, 'no_edit': True}" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>      
        </field>
    </record>
</odoo>