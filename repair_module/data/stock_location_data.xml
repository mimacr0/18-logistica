<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Repair Location: hijo de WH/Stock -->
        <record id="stock_location_repairs" model="stock.location">
            <field name="name">Repairs</field>
            <field name="usage">internal</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="barcode">WH-REPAIRS</field>
        </record>

        <!-- Scrap Location: hijo de WH/Stock -->
        <record id="stock_location_scrap" model="stock.location">
            <field name="name">Scrap</field>
            <field name="usage">inventory</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="barcode">WH-SCRAP</field>
            <field name="scrap_location">True</field>
        </record>

    </data>
</odoo>
