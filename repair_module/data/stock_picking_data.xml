<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="stock_picking_type_move_to_repair" model="stock.picking.type">
            <field name="name">Move to Repair</field>
            <field name="code">internal</field>
            <field name="sequence_code">MVREP</field>
            <field name="reservation_method">at_confirm</field>
            <field name="barcode">move_repair</field>
            <field name="create_backorder">never</field>
            <field name="default_location_src_id" ref="stock.stock_location_stock"/>
            <field name="default_location_dest_id" ref="repair_module.stock_location_repairs"/>
            <field name="use_create_lots">False</field>
            <field name="allowed_location_dest_ids" eval="[(6, 0, [ref('repair_module.stock_location_repairs')])]"/>
        </record>

        <!-- Tipo de operación para devolver productos de Reparaciones a Stock (reparación completada o cancelación) -->
        <record id="stock_picking_type_return_from_repair" model="stock.picking.type">
            <field name="name">Return from Repair</field>
            <field name="code">internal</field>
            <field name="sequence_code">RETREP</field>
            <field name="reservation_method">at_confirm</field>
            <field name="barcode">return_repair</field>
            <field name="create_backorder">never</field>
            <field name="default_location_src_id" ref="repair_module.stock_location_repairs"/>
            <field name="default_location_dest_id" ref="repair_module.stock_location_to_relocate"/>
            <field name="restrict_scan_tracking_number">mandatory</field>
            <field name="restrict_scan_dest_location">mandatory</field>
            <field name="use_create_lots">False</field>
            <field name="allowed_location_ids" eval="[(6, 0, [ref('repair_module.stock_location_repairs')])]"/>
        </record>

        <record id="seq_repair_review_picking" model="ir.sequence">
            <field name="name">Review Operation</field>
            <field name="code">repair.review</field>
            <!-- <field name="prefix">RVW%(y)s%(month)s</field> -->
            <field name="prefix">RVW</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_repair_operation_picking" model="ir.sequence">
            <field name="name">Repair Operation</field>
            <field name="code">repair.operation</field>
            <!-- <field name="prefix">REP%(y)s%(month)s</field> -->
            <field name="prefix">REP</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="picking_type_warehouse0_review" model="stock.picking.type">
            <field name="name">Review</field>
            <field name="code">repair_operation</field>
            <field name="sequence_code">REV</field>
            <field name="sequence_id" ref="seq_repair_review_picking"/>
            <field name="reservation_method">at_confirm</field>
            <field name="barcode">review_operation</field>
            <!-- Producto a reparar: viene de Repairs, va a Stock -->
            <field name="default_product_location_src_id" ref="repair_module.stock_location_repairs"/>
            <field name="default_product_location_dest_id" ref="stock.stock_location_stock"/>
            <!-- Componentes/piezas: origen y destino Stock -->
            <field name="default_location_src_id" ref="stock.stock_location_stock"/>
            <field name="default_location_dest_id" ref="stock.stock_location_stock"/>
            <field name="default_remove_location_dest_id" ref="repair_module.stock_location_scrap"/>
            <field name="default_recycle_location_dest_id" ref="repair_module.stock_location_scrap"/>

        </record>

        <!-- Modificar el tipo de operación Repair de Odoo para usar ubicación Repairs -->
        <record id="repair.picking_type_warehouse0_repair" model="stock.picking.type">
            <field name="default_product_location_src_id" ref="repair_module.stock_location_repairs"/>
            <field name="default_remove_location_dest_id" ref="repair_module.stock_location_scrap"/>
            <field name="default_recycle_location_dest_id" ref="repair_module.stock_location_scrap"/>
            <field name="sequence_id" ref="seq_repair_operation_picking"/>
        </record>
    </data>
</odoo>