<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="stock_picking_type_move_to_repair" model="stock.picking.type">
            <field name="name">Move to Repair</field>
            <field name="code">internal</field>
            <field name="sequence_code">MVREP1</field>
            <field name="reservation_method">at_confirm</field>
            <field name="barcode">move_repair</field>
            <field name="create_backorder">never</field>
            <field name="default_location_src_id" ref="stock.stock_location_stock"/>
            <field name="default_location_dest_id" ref="repair_module.stock_location_repairs"/>
            <field name="use_create_lots">False</field>
        </record>

        <record id="picking_type_warehouse0_review" model="stock.picking.type">
            <field name="name">Review</field>
            <field name="code">repair_operation</field>
            <field name="sequence_code">REV</field>
            <field name="reservation_method">at_confirm</field>
            <field name="barcode">review_operation</field>
            <!-- Producto a reparar: viene de Repairs, va a Stock -->
            <field name="default_product_location_src_id" ref="repair_module.stock_location_repairs"/>
            <field name="default_product_location_dest_id" ref="stock.stock_location_stock"/>
            <!-- Componentes/piezas: origen y destino Stock -->
            <field name="default_location_src_id" ref="stock.stock_location_stock"/>
            <field name="default_location_dest_id" ref="stock.stock_location_stock"/>
            <field name="default_remove_location_dest_id" ref="repair_module.stock_location_scrap"/>
            <field name="default_recycle_location_dest_id" ref="repair_module.stock_location_scrap"/>
        </record>

        <!-- Modificar el tipo de operación Repair de Odoo para usar ubicación Repairs -->
        <record id="repair.picking_type_warehouse0_repair" model="stock.picking.type">
            <field name="default_product_location_src_id" ref="repair_module.stock_location_repairs"/>
            <field name="default_remove_location_dest_id" ref="repair_module.stock_location_scrap"/>
            <field name="default_recycle_location_dest_id" ref="repair_module.stock_location_scrap"/>
        </record>
    </data>
</odoo>