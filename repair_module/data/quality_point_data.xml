<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--FIRST, create the picking types-->

        <record id="stock_picking_type_review_batch" model="stock.picking.type">
            <field name="name">Review Batch</field>
            <field name="code">internal</field>
            <field name="sequence_code">REV</field>
            <field name="reservation_method">at_confirm</field>
            <field name="barcode">review_batch</field>
            <field name="create_backorder">never</field>
            <!-- <field name="default_product_location_src_id"></field> -->
            <!-- <field name="default_product_location_dest_id"></field> -->
        </record>
        <record id="stock_picking_type_review_one_by_one" model="stock.picking.type">
            <field name="name">Review One By One</field>
            <field name="code">internal</field>
            <field name="sequence_code">REV</field>
            <field name="reservation_method">at_confirm</field>
            <field name="barcode">review_one_by_one</field>
            <field name="create_backorder">never</field>
            <!-- <field name="default_product_location_src_id"></field> -->
            <!-- <field name="default_product_location_dest_id"></field> -->
        </record>
        <record id="stock_picking_type_repair_batch" model="stock.picking.type">
            <field name="name">Repair Batch</field>
            <field name="code">internal</field>
            <field name="sequence_code">REP</field>
            <field name="reservation_method">at_confirm</field>
            <field name="barcode">repair_batch</field>
            <field name="create_backorder">never</field>
            <!-- <field name="default_product_location_src_id"></field> -->
            <!-- <field name="default_product_location_dest_id"></field> -->
        </record>
        <record id="stock_picking_type_repair_one_by_one" model="stock.picking.type">
            <field name="name">Repair One By One</field>
            <field name="code">internal</field>
            <field name="sequence_code">REP</field>
            <field name="reservation_method">at_confirm</field>
            <field name="barcode">repair_one_by_one</field>
            <field name="create_backorder">never</field>
            <!-- <field name="default_product_location_src_id"></field> -->
            <!-- <field name="default_product_location_dest_id"></field> -->
        </record>


        <!-- SECOND. Create the quality point to relate the stock.picking actions -->
        <record id="quality_point_control_batch" model="quality.point">
            <field name="title">Control Batch</field>
            <field name="team_id" ref="quality.quality_alert_team0"/>
            <field name="measure_on">product</field>
            <field name="measure_frequency_type">all</field>
            <field name="test_type">passfail</field>
            <field name="picking_type_ids" eval="[(4, ref('stock_picking_type_review_batch')), (4, ref('stock_picking_type_repair_batch'))]"/>
        </record>

        <record id="quality_point_control_one_by_one" model="quality.point">
            <field name="title">Control One By One</field>
            <field name="team_id" ref="quality.quality_alert_team0"/>
            <field name="measure_on">move_line</field>
            <field name="measure_frequency_type">all</field>
            <field name="test_type">passfail</field>
            <field name="picking_type_ids" eval="[(4, ref('stock_picking_type_review_one_by_one')), (4, ref('stock_picking_type_repair_one_by_one'))]"/>
        </record>


        <record id="quality_alert_stage_in_transit_reception" model="quality.alert.stage">
            <field name="name">In Transit (Reception)</field>
            <field name="sequence">10</field>
        </record>

        <record id="quality_alert_stage_in_warehouse" model="quality.alert.stage">
            <field name="name">In Warehouse</field>
            <field name="sequence">20</field>
        </record>

        <record id="quality_alert_stage_preliminary_review" model="quality.alert.stage">
            <field name="name">Preliminary Review</field>
            <field name="sequence">30</field>
        </record>

        <record id="quality_alert_stage_sent_to_review" model="quality.alert.stage">
            <field name="name">Sent for Review</field>
            <field name="sequence">40</field>
        </record>

        <record id="quality_alert_stage_sent_to_repair" model="quality.alert.stage">
            <field name="name">Sent for Repair</field>
            <field name="sequence">50</field>
        </record>

        <record id="quality_alert_stage_sent_to_postsale" model="quality.alert.stage">
            <field name="name">Sent to After-Sales</field>
            <field name="sequence">60</field>
        </record>

        <record id="quality_alert_stage_sent_to_recycle" model="quality.alert.stage">
            <field name="name">Sent for Recycling</field>
            <field name="sequence">70</field>
        </record>

        <record id="quality_alert_stage_in_transit_shipping" model="quality.alert.stage">
            <field name="name">In Transit (Shipping)</field>
            <field name="sequence">80</field>
        </record>

        <record id="quality_alert_stage_sent" model="quality.alert.stage">
            <field name="name">Sent</field>
            <field name="sequence">90</field>
        </record>

        <record id="quality_alert_stage_received" model="quality.alert.stage">
            <field name="name">Received</field>
            <field name="sequence">100</field>
        </record>


    </data>
</odoo>