<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_alert_cancel_wizard_form" model="ir.ui.view">
        <field name="name">quality.alert.cancel.wizard.form</field>
        <field name="model">quality.alert.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Quality Alert">
                <group>
                    <field name="alert_id" invisible="1"/>
                    <field name="has_done_pickings" invisible="1"/>
                    <field name="has_repairs" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not has_done_pickings">
                        <strong>Warning:</strong> This alert has completed stock movements.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not has_repairs">
                        <strong>Warning:</strong> This alert has associated repair/review orders that will also be cancelled.
                    </div>
                    <field name="reason" placeholder="Enter the cancellation reason..."/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" string="Confirm Cancellation" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_quality_alert_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancel Alert</field>
        <field name="res_model">quality.alert.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
