<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_technician_change_form" model="ir.ui.view">
        <field name="name">repair.technician.change.form</field>
        <field name="model">repair.technician.change</field>
        <field name="arch" type="xml">
            <form string="Change Technician">
                <group>
                    <field name="technician_id"/>
                </group>
                <footer>
                    <button string="Change" type="object" name="action_change_technician" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>