<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        Record Rules for Repair Orders
        - Users can only see repairs assigned to them
        - Managers can see all repairs
    -->

    <!-- Repair User: Only see own repairs -->
    <record id="repair_order_rule_user" model="ir.rule">
        <field name="name">Repair Order: User sees own repairs</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="domain_force">[('technician_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('logistics_security.group_repair_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Repair Manager: See all repairs -->
    <record id="repair_order_rule_manager" model="ir.rule">
        <field name="name">Repair Order: Manager sees all</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('logistics_security.group_repair_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

