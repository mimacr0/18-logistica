<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Override repair module access: remove create/unlink for stock.group_stock_user -->
    <record id="repair.access_repair_user" model="ir.model.access">
        <field name="name">Repair user</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="group_id" ref="stock.group_stock_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
