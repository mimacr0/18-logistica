<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generate_serial_wizard_form" model="ir.ui.view">
        <field name="name">generate.serial.wizard.form</field>
        <field name="model">generate.serial.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Serial Numbers">
                <group>
                    <field name="picking_id" invisible="1"/>
                    <field name="move_line_count" invisible="1"/>
                    <field name="message" nolabel="1" widget="html"/>
                </group>
                <footer>
                    <button string="Generate Serial Numbers" name="action_generate_serials" type="object" class="btn-primary"/>
                    <button string="Cancel" name="action_cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
