<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Quality Check Form to add IMEI validation button -->
        <record id="quality_check_view_form_inherit_imei" model="ir.ui.view">
            <field name="name">quality.check.view.form.inherit.imei</field>
            <field name="model">quality.check</field>
            <field name="inherit_id" ref="quality_control.quality_check_view_form"/>
            <field name="arch" type="xml">
                <!-- Add Validate IMEI button in header -->
                <xpath expr="//header/button[@name='do_alert']" position="after">
                    <button name="action_validate_imei" 
                            type="object" 
                            string="Validate IMEI" 
                            class="btn-secondary"
                            invisible="not lot_line_id and not lot_name"
                            data-hotkey="i"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
