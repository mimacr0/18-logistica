<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Inventory Settings to add IMEI Quality Control section -->
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.quality.imei</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="35"/>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <!-- Add new block after quality_control setting -->
                <xpath expr="//setting[@id='quality_control']" position="after">
                    <setting id="quality_imei_settings" 
                             string="IMEI Quality Control API"
                             help="Configure IMEI validation API for quality checks"
                             invisible="not module_quality_control">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="quality_imei_api_url" string="API URL" class="col-lg-3 o_light_label"/>
                                <field name="quality_imei_api_url" 
                                       placeholder="https://api.example.com/validate-imei"
                                       class="col-lg-8"/>
                            </div>
                            <div class="row">
                                <label for="quality_imei_api_key" string="API Key" class="col-lg-3 o_light_label"/>
                                <field name="quality_imei_api_key" 
                                       password="True"
                                       placeholder="Enter your API key"
                                       class="col-lg-8"/>
                            </div>
                            <div class="row">
                                <label for="quality_imei_api_timeout" string="Timeout" class="col-lg-3 o_light_label"/>
                                <field name="quality_imei_api_timeout" 
                                       class="col-lg-2"/>
                                <span class="col-lg-6 o_form_label">seconds</span>
                            </div>
                            <div class="row">
                                <label for="quality_imei_validation_required" string="Validation Required" class="col-lg-3 o_light_label"/>
                                <field name="quality_imei_validation_required" 
                                       class="col-lg-8"/>
                            </div>
                            <div class="row">
                                <label for="quality_imei_category_ids" string="Product Categories" class="col-lg-3 o_light_label"/>
                                <field name="quality_imei_category_ids" 
                                       widget="many2many_tags"
                                       placeholder="Leave empty to validate all products"
                                       class="col-lg-8"/>
                            </div>
                        </div>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
