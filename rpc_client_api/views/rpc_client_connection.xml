<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="rpc_client_connection_search" model="ir.ui.view">
            <field name="name">rpc.client.connection.search</field>
            <field name="model">rpc.client.connection</field>
            <field name="arch" type="xml">
                <search string="Connections">
                    <field name="name" string="Connections" filter_domain="['|','|', ('name', 'ilike', self), ('client_user', 'ilike', self), ('url', 'ilike', self)]"/>
                </search>
            </field>
        </record>

        <record id="rpc_client_connection_tree" model="ir.ui.view">
            <field name="name">rpc.client.connection.tree</field>
            <field name="model">rpc.client.connection</field>
            <field name="arch" type="xml">
                <list string="Connections">
                    <field name="name"/>
                    <field name="client_user"/>
                    <field name="url"/>
                </list>
            </field>
        </record>

        <record id="rpc_client_connection_form" model="ir.ui.view">
            <field name="name">rpc.client.connection.form</field>
            <field name="model">rpc.client.connection</field>
            <field name="arch" type="xml">
                <form string="Connections">
                    <header>
                        <button name="action_test_connection" type="object" class="oe_highlight" string="Test" invisible="state != 'disconnected'"/>
                        <button name="action_download_public_key" type="object" string="Public Key" invisible="not rpc_key_id or not client_user"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <div class="d-flex">
                                    <field class="text-break" name="name" placeholder="Connection name"/>
                                </div>
                            </h1>
                        </div>
                        <group>
                            <label for="client_user"/>
                            <div>
                                <field name="client_user" class="oe_inline" readonly="1" force_save="1"/>
                                <button name="generate_client_user_action" type="object" string="Generate" class="oe_link" invisible="client_user"/>
                                <button name="generate_client_user_action" type="object" string="Generate" class="oe_link" invisible="not client_user" confirm="Are you sure you want to generate a new client user? This will invalidate the current client user."/>
                            </div>
                            <field name="rpc_key_id" required="1"/>
                            <field name="url" required="1"/>
                            <field name="json_rpc" widget="boolean_toggle"/>
                            <field name="last_token" readonly="1" force_save="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="rpc_client_connection_action" model="ir.actions.act_window">
            <field name="name">Connections</field>
            <field name="res_model">rpc.client.connection</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
