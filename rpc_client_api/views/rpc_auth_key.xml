<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rpc_auth_key_search" model="ir.ui.view">
            <field name="name">rpc.auth.key.search</field>
            <field name="model">rpc.auth.key</field>
            <field name="arch" type="xml">
                <search string="Auth Keys">
                    <field name="name" string="Auth Keys" filter_domain="['|', ('name', 'ilike', self), ('size', 'ilike', self)]"/>
                </search>
            </field>
        </record>

        <record id="rpc_auth_key_tree" model="ir.ui.view">
            <field name="name">rpc.auth.key.tree</field>
            <field name="model">rpc.auth.key</field>
            <field name="arch" type="xml">
                <list string="Auth Keys">
                    <field name="name"/>
                    <field name="size"/>
                </list>
            </field>
        </record>

        <record id="rpc_auth_key_form" model="ir.ui.view">
            <field name="name">rpc.auth.key.form</field>
            <field name="model">rpc.auth.key</field>
            <field name="arch" type="xml">
                <form string="Auth Keys">

                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <div class="d-flex">
                                    <field class="text-break" name="name" placeholder="e.g. General"/>
                                </div>
                            </h1>
                        </div>

                        <group>
                            <field name="size"/>
                            <field name="private_key" filename="private_key_filename"/>
                            <field name="private_key_filename" invisible="1"/>
                            <field name="public_key" filename="public_key_filename"/>
                            <field name="public_key_filename" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="rpc_auth_key_action" model="ir.actions.act_window">
            <field name="name">Auth Keys</field>
            <field name="res_model">rpc.auth.key</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
