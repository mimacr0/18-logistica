<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action for Product Templates -->
    <record id="action_product_template_rma" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('type', '=', 'service')]</field>
        <field name="context">{'default_type': 'service'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product
            </p>
        </field>
    </record>

    <!-- Action for Product Variants -->
    <record id="action_product_product_rma" model="ir.actions.act_window">
        <field name="name">Services Variants</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('type', '=', 'service')]</field>
        <field name="context">{'default_type': 'service'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product variant
            </p>
        </field>
    </record>

    <!-- Action for Spare Parts -->
    <record id="action_product_spare_parts_rma" model="ir.actions.act_window">
        <field name="name">Spare Parts</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_spare_parts', '=', True), ('type', '!=', 'service')]</field>
        <field name="context">{'default_is_spare_parts': True, 'default_type': 'consu'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new spare part
            </p>
        </field>
    </record>

    <!-- Inherit Product Template Form to add is_spare_parts -->
    <record id="product_template_form_view_rma_repair" model="ir.ui.view">
        <field name="name">product.template.form.inherit.rma.repair</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="is_spare_parts"/>
                    <label for="is_spare_parts"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
