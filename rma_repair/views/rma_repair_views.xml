<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="rma_repair_view_tree" model="ir.ui.view">
        <field name="name">rma.repair.view.tree</field>
        <field name="model">rma.repair</field>
        <field name="arch" type="xml">
            <list string="Repairs">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="product_id"/>
                <field name="account_id"/>
                <field name="technician_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="rma_repair_view_form" model="ir.ui.view">
        <field name="name">rma.repair.view.form</field>
        <field name="model">rma.repair</field>
        <field name="arch" type="xml">
            <form string="Repair">
                <header>
                    <button name="action_confirm_repair" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state not in ['confirmed', 'cancel']"/>
                    <button name="action_done_repair" string="Mark as Done" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="unit_id" options="{'no_create': True}"/>
                            <field name="product_id"/>
                            <field name="unit_condition" readonly="state != 'confirmed'"/>
                        </group>
                        <group>
                            <field name="account_id"/>
                            <field name="technician_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="mb-2" name="action_buttons">
                        <button name="action_open_add_parts_wizard" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-plus-square" 
                                string="Add Spare Parts"/>
                        <button name="action_open_harvest_wizard" 
                                type="object" 
                                class="oe_stat_button ms-2" 
                                icon="fa-scissors" 
                                string="Harvest Parts"/>
                    </div>
                    <notebook>
                        <page string="Operations" name="operations">
                            <field name="operation_ids">
                                <list editable="bottom">
                                    <field name="type"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="price_unit"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Parts" name="spare_parts">
                            <field name="spare_part_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="location_id"/>
                                    <field name="lot_id" optional="hide"/>
                                    <field name="quantity" string="Available Qty"/>
                                    <field name="owner_id" optional="show" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Diagnostics &amp; Results" name="notes">
                            <group>
                                <field name="diagnostic_notes" placeholder="Detailed diagnostic info..."/>
                                <field name="result_notes" placeholder="Repair result details..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="rma_repair_view_kanban" model="ir.ui.view">
        <field name="name">rma.repair.view.kanban</field>
        <field name="model">rma.repair</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="unit_id"/>
                <field name="product_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="unit_id"/>
                                </div>
                                <div>
                                    <field name="product_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'confirmed': 'warning', 'done': 'success'}}"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="technician_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_rma_repair" model="ir.actions.act_window">
        <field name="name">Repairs</field>
        <field name="res_model">rma.repair</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new repair record
            </p>
        </field>
    </record>
</odoo>
