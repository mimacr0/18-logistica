<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="web.brand_promotion_message">
        <xpath expr="//final_message" position="replace">
            <div class="o_brand_promotion">
                <span>System designed by</span>
                <a target="_blank" class="badge text-bg-light" href="https://www.dafe.es">
                    <img alt="DaFe" src="/web_theme/static/img/dafe_logo_tiny.webp" width="62" height="20" style="width: auto; height: 1.3em; vertical-align: baseline;"/>
                </a>
            </div>
        </xpath>
    </template>

    <template id="login_layout_hide_powered_by_and_manage_db" inherit_id="web.login_layout" name="Login Layout">
        <xpath expr="//div[hasclass('container', 'py-5')]" position="before">
            <t t-set="disable_footer" t-value="1"/>
        </xpath>
    </template>

    <template id="hide_powered_by_odoo_sidebar" inherit_id="portal.portal_record_sidebar">
        <xpath expr="//div/div/div[2]" position="replace"/>
    </template>

    <function model="ir.ui.menu" name="write">
        <value eval="[ref('base.menu_management')]"/>
        <value eval="{'groups_id': [(4, ref('base.group_system'))]}"/>
    </function>
</odoo>