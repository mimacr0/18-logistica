<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rma_reception_check_template_form" model="ir.ui.view">
        <field name="name">rma.reception.check.template.form</field>
        <field name="model">rma.reception.check.template</field>
        <field name="arch" type="xml">
            <form string="Reception Check Template">
                <sheet>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_rma_reception_check_template_list" model="ir.ui.view">
        <field name="name">rma.reception.check.template.list</field>
        <field name="model">rma.reception.check.template</field>
        <field name="arch" type="xml">
            <list string="Reception Check Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
                <field name="type"/>
            </list>
        </field>
    </record>

    <record id="action_rma_reception_check_template" model="ir.actions.act_window">
        <field name="name">Reception Check Template</field>
        <field name="res_model">rma.reception.check.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="rma_reception.view_rma_reception_check_template_list"/>
    </record>
</odoo>