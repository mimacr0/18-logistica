<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rma_reception.PackageReception">
        <div class="o_action o_rma_package_reception o_rma_desk_receive touch-manipulation h-100 d-flex flex-column bg-view overflow-auto">
            <div class="o_rma_desk_receive_header o_barcode_header border-bottom">
                <div class="navbar navbar-expand navbar-dark px-2">
                    <div class="navbar-nav me-auto align-items-center flex-wrap">
                        <button type="button" class="btn nav-link text-white me-3" t-on-click="exit" title="Volver">
                            <i class="oi oi-chevron-left"/>
                        </button>
                        <span class="navbar-text text-white fw-bold" t-out="title"/>
                    </div>
                    <div class="navbar-nav">
                        <button type="button" class="btn nav-link text-white" t-on-click="exit" title="Cerrar">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                </div>
            </div>

            <div class="o_rma_desk_receive_banner o_rma_reception_banner row alert alert-light m-0 py-3 border-0 rounded-0 border-bottom">
                <div class="d-flex align-items-center justify-content-center w-100 gap-3 flex-wrap">
                    <i t-if="info.icon" t-attf-class="fa fa-3x fa-{{info.icon}} text-primary"/>
                    <span class="fs-5 text-center" t-attf-class="{{info.class}}">
                        <t t-out="info.message"/>
                    </span>
                </div>
            </div>

            <div class="o_rma_desk_receive_search container-fluid py-3 border-bottom bg-light bg-opacity-50">
                <div class="row justify-content-center">
                    <div class="col-12 col-lg-8">
                        <div class="input-group input-group-lg o_rma_desk_receive_search_group">
                            <input type="text" class="form-control o_rma_desk_receive_search_input" t-ref="search-input"
                                   t-att-placeholder="searchPlaceholder"
                                   autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                                   inputmode="none"
                                   t-on-keydown="onSearchKeydown"
                                   t-on-keyup="debounceSearch"/>
                            <button type="button" class="btn btn-outline-primary" t-on-click="searchPackages">
                                <t t-out="searchButtonLabel"/>
                            </button>
                        </div>
                        <p class="text-muted small mt-2 mb-0" t-out="searchHint"/>
                    </div>
                </div>
            </div>

            <div class="o_rma_desk_receive_body container-fluid flex-grow-1 py-3">
                <div class="row justify-content-center g-3 mb-3" t-if="showPendingReceptionListButton">
                    <div class="col-12 col-md-8 col-lg-6">
                        <button type="button"
                                class="btn btn-primary w-100 py-3 o_rma_reception_btn_pending_list"
                                t-on-click="openDoorReceptionList">
                            <i class="fa fa-list-ul me-2"/>
                            <t t-out="findReceptionLabel"/>
                        </button>
                    </div>
                </div>
                <!-- Lista Door Reception o varios resultados de búsqueda: elegir un bulto -->
                <div class="row justify-content-center mt-1 mb-3" t-if="showPackageCandidateList">
                    <div class="col-12 col-xl-10">
                        <p class="text-muted small mb-2" t-out="packageListHint"/>
                        <div class="list-group shadow-sm">
                            <RmaReceptionPackageSearchLine t-foreach="state.searchCandidates" t-as="pkg" t-key="pkg.id"
                                                           line="pkg"
                                                           isSelected="false"
                                                           onSelect.bind="selectCandidate"/>
                        </div>
                    </div>
                </div>
                <div class="row justify-content-center pb-4 pb-lg-5" t-if="canShowWizardEmbed">
                    <div class="col-12 col-xl-10 o_rma_desk_receive_wizard_embed position-relative">
                        <div class="card shadow-sm border o_rma_reception_wizard_card">
                            <div class="card-header bg-light border-bottom py-3 px-3 px-md-4">
                                <h5 class="card-title mb-0 fs-6 text-body d-flex align-items-center gap-2 flex-wrap">
                                    <i class="fa fa-inbox o_rma_reception_wizard_header_icon" aria-hidden="true"/>
                                    <span t-out="wizardSectionTitle"/>
                                </h5>
                                <p class="text-muted small mb-0 mt-2" t-out="wizardSectionSubtitle"/>
                            </div>
                            <div class="card-body p-3 p-md-4 o_rma_reception_wizard_body">
                                <View t-key="state.wizardMountKey" t-props="getWizardViewProps()"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
