<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rma_reception_desk_store_wizard_form" model="ir.ui.view">
        <field name="name">rma.reception.desk.store.wizard.form</field>
        <field name="model">rma.reception.desk.store.wizard</field>
        <field name="arch" type="xml">
            <form string="Almacenar en almacén">
                <field name="package_id" invisible="1"/>
                <p class="text-muted mb-3">
                    Elija una ubicación interna por línea. Los quants saldrán del bulto hacia esa ubicación.
                </p>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="line_type" column_invisible="1"/>
                        <field name="display_name" string="Artículo" readonly="1"/>
                        <field name="location_id" string="Ubicación" options="{'no_create': True}"/>
                        <field name="rma_unit_id" column_invisible="1"/>
                        <field name="quant_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Aplicar" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
