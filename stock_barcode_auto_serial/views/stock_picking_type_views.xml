<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_type_form_auto_serial" model="ir.ui.view">
        <field name="name">stock.picking.type.form.auto.serial</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_existing_lots']" position="after">
                <field name="require_scan_confirmation"/>
                <field name="show_print_lot_labels"/>
            </xpath>
        </field>
    </record>
</odoo>
