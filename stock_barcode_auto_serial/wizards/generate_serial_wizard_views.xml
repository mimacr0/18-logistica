<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_generate_serial_wizard_form" model="ir.ui.view">
        <field name="name">generate.serial.wizard.form</field>
        <field name="model">generate.serial.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Serial Numbers">
                <field name="picking_id" invisible="1"/>
                <field name="move_line_count" invisible="1"/>
                <group>
                    <field name="message" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_generate_serials" string="Generate" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
