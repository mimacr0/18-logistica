<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="receive_package_wizard_form_view" model="ir.ui.view">
        <field name="name">receive.package.wizard.form.view</field>
        <field name="model">receive.package.wizard</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form string="Receive Package" class="o_barcode_line_form flex-column">
                <div class="row mt-4 mb-4 col-12">
                    <div class="col-12 d-flex align-items-baseline">
                        <i class="fa fa-fw fa-lg fa-search me-3" title="Enter a tracking code (required)"/>
                        <field name="search_tracking_ref" placeholder="Scan or enter a tracking code (required)" nolabel="1"/>
                    </div>
                </div>
                <div class="row mt-4 mb-4 col-12" invisible="not carrier_tracking_ref and not global_tracking_ref and not package_name"> 
                    <div class="col-12 d-flex align-items-baseline">
                        <i class="fa fa-fw fa-lg fa-barcode me-3" title="Enter a package name"/>
                        <field name="carrier_tracking_ref" nolabel="1"/>
                    </div>
                </div>
                <div class="row mt-4 mb-4" invisible="not carrier_tracking_ref and not global_tracking_ref and not package_name">
                    <div class="col-12 d-flex align-items-baseline">
                        <i class="fa fa-fw fa-lg fa-barcode me-3" title="Enter a package name"/>
                        <field name="global_tracking_ref" nolabel="1"/>
                    </div>
                </div>
                <div class="row mt-4 mb-4" invisible="not carrier_tracking_ref and not global_tracking_ref and not package_name">
                    <div class="col-12 d-flex align-items-baseline">
                        <i class="fa fa-fw fa-lg fa-book me-3" title="Package"/>
                        <field name="package_id" placeholder="Package" nolabel="1" options="{'no_create':True, 'create_edit': false, 'no_open': True}"/>
                    </div>
                </div>
                <div class="row mt-4 mb-4" invisible="not carrier_tracking_ref and not global_tracking_ref and not package_name">
                    <div class="col-12 d-flex align-items-baseline">
                        <i class="fa fa-fw fa-lg fa-archive me-3" title="Package Type"/>
                        <field name="package_type_id" nolabel="1" widget="selection_badge"/>
                    </div>
                </div>
                <div class="row mt-4 mb-4" invisible="not carrier_tracking_ref and not global_tracking_ref and not package_name">
                    <div class="col-12 d-flex align-items-baseline">
                        <i class="fa fa-fw fa-lg fa-cube me-3" title="Measures (mm)"/>
                        <field name="packaging_length" placeholder="Length" nolabel="1"/>
                        <span class="p-2">×</span>
                        <field name="width" placeholder="Width" nolabel="1"/>
                        <span class="p-2">×</span>
                        <field name="height" placeholder="Height" nolabel="1"/>
                        <span class="p-2">mm</span>
                    </div>
                </div>
                <div class="row mt-4 mb-4" invisible="not carrier_tracking_ref and not global_tracking_ref and not package_name">
                    <div class="col-7 d-flex align-items-baseline">
                        <i class="fa fa-fw fa-lg fa-balance-scale me-3" title="Weight (kg)"/>
                        <field name="weight" placeholder="Weight (kg)" nolabel="1"/>
                    </div>
                </div>
                <div class="row mt-4 mb-4" invisible="not carrier_tracking_ref and not global_tracking_ref and not package_name">
                    <div class="col-12 d-flex align-items-baseline">
                        <i class="fa fa-fw fa-lg  fa-map-marker me-3" title="Destination Location "/>
                        <field name="location_id" nolabel="1"/>
                    </div>
                </div>
                <!-- <div class="row mt-4 mb-4" invisible="not carrier_tracking_ref and not global_tracking_ref and not package_name">
                    <div class="col-12 d-flex align-items-baseline">
                        <i class="fa fa-fw fa-lg fa-calendar me-3" title="Received date"/>
                        <label for="received_date" class="me-2" style="font-size: 1.4rem;"/>
                        <field name="received_date" readonly="1"/>
                    </div>
                </div> -->
                <div class="row mt-4 mb-4" invisible="not carrier_tracking_ref and not global_tracking_ref and not package_name">
                    <div class="col-12 d-flex align-items-baseline">
                        <i class="fa fa-fw fa-lg fa-upload me-3" title="Images / videos"/>
                        <field name="media_ids" widget="many2many_binary" nolabel="1" options="{'accepted_file_extensions': 'image/*,video/*'}"/>
                    </div>
                </div>
                <div class="row mt-4 mb-4" invisible="not carrier_tracking_ref and not global_tracking_ref and not package_name">
                    <div class="col-12 d-flex align-items-baseline">
                        <i class="fa fa-fw fa-lg fa-user me-3" title="Person receiving"/>
                        <label for="receiver_id" class="me-2" style="font-size: 1.4rem;"/>
                        <field name="receiver_id" readonly="1"/>
                    </div>
                </div>
                <div class="fixed-bottom" invisible="not carrier_tracking_ref and not global_tracking_ref and not package_name">
                    <div class="o_barcode_control d-flex">
                        <button string="Discard" class="btn btn-secondary o_discard" special="cancel"/>
                        <button string="Confirm" class="btn btn-primary o_save" type="object" name="action_confirm"/>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="action_receive_package_wizard" model="ir.actions.act_window">
        <field name="name">Receive Package</field>
        <field name="res_model">receive.package.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock_reception.receive_package_wizard_form_view"/>
        <field name="target">current</field>
    </record>

</odoo>
