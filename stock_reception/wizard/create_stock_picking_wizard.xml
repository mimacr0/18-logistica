<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.ui.view" id="create_stock_picking_wizard_view">
        <field name="name">create.stock.picking.wizard.view</field>
        <field name="model">create.stock.picking.wizard</field>
        <field name="priority">1500</field>
        <field name="arch" type="xml">
            <form string="Create Package Reception">
                <sheet>
                    <group name="Package Information" string="Package Information">
                        <group>
                            <field name="account_partner_id" placeholder="Account" options="{'no_create': True, 'no_open': True}" readonly="1"/>
                            <!-- <field name="package_name" readonly="1"/> -->
                        </group>
                        <group>
                            <field name="location_dest_id" placeholder="Location" options="{'no_create': True, 'no_open': True}" domain="[('usage', '=', 'internal')]" readonly="1"/>
                            <field name="pack_date" placeholder="Date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <label for="package_type_id" string="Package Type" invisible="0"/>
                        <h2>
                            <field name="package_type_id" widget="selection_badge" options="{'horizontal': true}" />
                        </h2>
                        <label for="packaging_length" help="Size: Length × Width × Height" string="Measures (mm)"/>
                        <div class="o_row" name="size">
                            <field name="packaging_length" placeholder="Length" readonly="1"/>
                            <span>×</span>
                            <field name="width" placeholder="Width" readonly="1"/>
                            <span>×</span>
                            <field name="height" placeholder="Height" readonly="1"/>
                            <span>mm</span>
                        </div>
                        <field name="packaging_weight" readonly="1"></field>
                    </group>
                    <group name="Carrier Information" string="Carrier Information">
                        <group>
                            <field name="carrier_id"  options="{'horizontal': true}" />
                            <field name="global_tracking_ref" placeholder="(Required Reference)"/>
                        </group>
                        <group>
                            <field name="carrier_name"/>
                            <field name="optional_tracking_ref" placeholder="(Optional Reference)"/>
                        </group>
                    </group>
                    <group>
                        <field name="scheduled_date" placeholder="Scheduled Date"/>

                    </group>
                    <field name="reception_line_ids" widget="many2many_list" options="{'no_create': True, 'no_edit': True, 'no_open': True}" >
                        <list editable="bottom">
                            <field name="box_number"/>
                            <field name="product_id" placeholder="Product" options="{'no_create': True, 'no_open': True}"/>
                            <field name="product_uom_qty" placeholder="Quantity" required="1"/>
                            <field name="location_id" column_invisible="1"/>
                            <field name="location_dest_id" column_invisible="1"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_new_reception" string="Create Reception" type="object" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_reception_create_stock_picking_form" model="ir.actions.act_window">
        <field name="name">Create Picking</field>
        <field name="res_model">create.stock.picking.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_stock_reception_create_stock_picking" model="ir.actions.act_window">
        <field name="name">Create Picking</field>
        <field name="res_model">create.stock.picking.wizard</field>
        <field name="binding_model_id" ref="stock.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_active_ids': active_id}</field>
        <field name="target">new</field>
    </record>
</odoo>
