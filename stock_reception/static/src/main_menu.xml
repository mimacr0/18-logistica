<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="stock_barcode.MainMenu" t-inherit-mode="extension" owl="1">

        <xpath expr="//div[hasclass('o_stock_barcode_main_menu')]/footer/button[hasclass('o_button_operations')]" position="before">
            <button class="button_package_reception btn btn-block btn-primary mb-3 p-3 w-100"
                    t-on-click="() => this.actionService.doAction('stock_reception.action_receive_package_server')">
                Package Reception
            </button>

        </xpath>
    </t>
</templates>
