<?xml version="1.0" encoding="UTF-8" ?>
<templates>

    <t t-name="stock_reception.LocationComponent" owl="1">

        <select class="form-control form-control-line" required="1" name="carrier_id" id="stock-reception-form-location-id">
            <option value="">Select location</option>
            <t t-foreach="locationList" t-as="location" t-key="location.id">
                <option t-att-value="location.id"><t t-esc="location.name"/></option>
            </t>
        </select>

    </t>

</templates>