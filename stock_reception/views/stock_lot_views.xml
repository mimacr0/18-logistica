<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_production_lot_view_form" model="ir.ui.view">
        <field name="name">stock.production.lot.view.form</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">  
            <xpath expr="//notebook/page[@name='description']" position="after">
                <page string="Additional Info" name="additional_info">
                    <group>
                        <field name="pakcage_id"/>
                    </group>
                </page>
            </xpath>      
        </field>
    </record>

</odoo>
