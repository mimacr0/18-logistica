<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="stock_reception_view_picking_form" model="ir.ui.view">
            <field name="name">stock.reception.view.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="invisible">is_reception</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="account_partner_id" nolabel="1" readonly="state in ['cancel', 'done']" invisible="not is_reception"/>
                </xpath>
                <xpath expr="//field[@name='owner_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>


        <record id="vpicktree_view_tree" model="ir.ui.view">
            <field name="name">stock.picking.delivery.list.inherit.delivery</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="column_invisible">0</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="account_partner_id" optional="show" readonly="state in ['cancel', 'done']"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>