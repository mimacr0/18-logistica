<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_receive_package_client" model="ir.actions.client">
        <field name="name">Receive Package</field>
        <field name="tag">stock_reception.ReceivePackage</field>
        <field name="context">{"model": "receive.package.wizard"}</field>
    </record>

    <record id="action_receive_package_server" model="ir.actions.server">
        <field name="name">Package Reception</field>
        <field name="model_id" ref="stock_reception.action_receive_package_server"/>
        <field name="state">code</field>
        <field name="code">
action = env.ref('stock_reception.action_receive_package_client').sudo().read()[0]
wizard = env['receive.package.wizard'].create({})
action['context'] = { 'wizard_id': wizard.id, 'model': 'receive.package.wizard' }
        </field>
    </record>


</odoo>
