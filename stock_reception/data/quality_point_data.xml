<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Quality Point for Quality Control picking type (3-step reception) -->
        <record id="quality_point_quality_control" model="quality.point">
            <field name="name">Quality Control - Reception Inspection</field>
            <field name="title">Product Quality Inspection</field>
            <field name="picking_type_ids" search="[('name', '=', 'Control de calidad')]"/>
            <field name="measure_on">product</field>
            <field name="measure_frequency_type">all</field>
            <field name="test_type_id" ref="quality_control.test_type_passfail"/>
            <field name="team_id" ref="quality.quality_alert_team0"/>
            <field name="note">
                <![CDATA[
                <p><strong>Quality Control Instructions:</strong></p>
                <ol>
                    <li>Verify that the product matches the delivery note</li>
                    <li>Visually inspect the product condition</li>
                    <li>Confirm the serial/lot number is correct</li>
                    <li>Document any visible damage</li>
                </ol>
                ]]>
            </field>
        </record>

    </data>
</odoo>
