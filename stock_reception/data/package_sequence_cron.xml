<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_restart_sequence" model="ir.cron">
        <field name="name">Restart Reception Package Sequence</field>
        <field name="model_id" ref="model_account_partner"/>
        <field name="state">code</field>
        <field name="code">model._restart_reception_sequence()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=0, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>

    </record>
</odoo>