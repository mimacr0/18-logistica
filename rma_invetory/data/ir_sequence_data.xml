<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for RMA Unit -->
        <record id="seq_rma_unit" model="ir.sequence">
            <field name="name">RMA Unit Sequence</field>
            <field name="code">rma.unit.sequence</field>
            <field name="prefix">RMA%(y)s%(month)s%(day)s</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
