<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Category isolated under Inventory -->
        <record id="module_category_rma" model="ir.module.category">
            <field name="name">RMA</field>
            <field name="description">Manage Return Materials Authorization</field>
            <field name="sequence">20</field>
            <field name="parent_id" ref="base.module_category_inventory"/>
        </record>

        <record id="group_rma_user" model="res.groups">
            <field name="name">RMA User</field>
            <field name="category_id" ref="module_category_rma"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_rma_manager" model="res.groups">
            <field name="name">RMA Manager</field>
            <field name="category_id" ref="module_category_rma"/>
            <field name="implied_ids" eval="[(4, ref('group_rma_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
