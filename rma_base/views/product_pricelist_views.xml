<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_pricelist_view_rma_rule_dates" model="ir.ui.view">
        <field name="name">product.pricelist.form.rma.rule.dates</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button
                    name="%(rma_base.action_rma_pricelist_item_dates_wizard)d"
                    type="action"
                    string="Set rule dates"
                    class="btn-secondary"
                    groups="product.group_product_manager"
                />
            </xpath>
        </field>
    </record>
</odoo>
