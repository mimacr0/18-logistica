<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_rma_harvest" model="ir.ui.view">
        <field name="name">product.template.form.rma.harvest</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_spare_parts" widget="toggle"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="RMA Harvest" name="rma_harvest" invisible="is_spare_parts or type != 'consu'">
                    <group>
                        <p class="text-muted" colspan="2">
                            Only products flagged as spare parts can be selected as harvest components.
                        </p>
                        <field name="components_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="component_tmpl_id" options="{'no_create': True}" domain="[('is_spare_parts', '=', True)]"/>
                                <field name="quantity"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_product_template_main" model="ir.actions.act_window">
        <field name="name">General Templates</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="view_id" eval="False"/>
        <field name="search_view_id" ref="product.product_template_search_view"/>
        <field name="context">{'search_default_goods': 1}</field>
    </record>
</odoo>
