<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_menu_product_attribute_value_list" model="ir.ui.view">
        <field name="name">product.attribute.value.list</field>
        <field name="model">product.attribute.value</field>
        <field name="arch" type="xml">
            <list string="Attribute Values">
                <field name="name"/>
                <field name="attribute_id" context="{'form_view_initial_mode': 'edit'}"/>
                <field name="default_extra_price"/>
            </list>
        </field>
    </record>

    <record id="product_menu_attributes_values_action" model="ir.actions.act_window">
        <field name="name">Attributres Values</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.attribute.value</field>
        <field name="view_mode">list,form</field>
        <field name="domain"></field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('product_menu_product_attribute_value_list')}),
            ]"/>
    </record>

</odoo>
