<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_menu_categories_list_view" model="ir.ui.view">
        <field name="name">product.menu.product.category.list</field>
        <field name="model">product.category</field>
        <field name="arch" type="xml">
            <list string="Categories" create="1" edit="0" >
                <field name="display_name"/>
            </list>
        </field>
    </record>

    <record id="product_menu_categories_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('product_menu.product_menu_categories_list_view')}),
            ]"/>
    </record>

</odoo>