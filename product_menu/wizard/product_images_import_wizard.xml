<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <!-- PRODUCT IMAGES IMPORT WIZARD -->

        <record id="product_images_import_wizard_action" model="ir.actions.act_window">
            <field name="name">Images Import</field>
            <field name="res_model">product.images.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record model="ir.ui.view" id="product_images_import_wizard_form_view">
            <field name="name">product.images.import.wizard.form</field>
            <field name="model">product.images.import.wizard</field>
            <field name="arch" type="xml">
                <form name="Images Import">
                    <group>
                        <field name="product_id" invisible="1"/>
                        <field name="image_ids" widget="many2many_binary" nolabel="1" options="{'accepted_file_extensions': 'image/*'}" colspan="2"/>
                    </group>
                    <footer>
                        <button name="import_action" type="object" string="Save" class="oe_highlight"/>
                        &amp;nbsp;
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>