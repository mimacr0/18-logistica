<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================ -->
        <!-- Product Attributes                           -->
        <!-- ============================================ -->

        <!-- Color Attribute -->
        <record id="product_attribute_color" model="product.attribute">
            <field name="name">Color</field>
            <field name="display_type">color</field>
            <field name="create_variant">always</field>
        </record>

        <!-- RAM Attribute -->
        <record id="product_attribute_ram" model="product.attribute">
            <field name="name">RAM</field>
            <field name="display_type">radio</field>
            <field name="create_variant">always</field>
        </record>

        <!-- ROM/Storage Attribute -->
        <record id="product_attribute_rom" model="product.attribute">
            <field name="name">ROM</field>
            <field name="display_type">radio</field>
            <field name="create_variant">always</field>
        </record>

        <!-- ============================================ -->
        <!-- Color Values                                 -->
        <!-- ============================================ -->

        <record id="product_attribute_value_color_black" model="product.attribute.value">
            <field name="name">Black</field>
            <field name="attribute_id" ref="product_attribute_color"/>
            <field name="html_color">#000000</field>
            <field name="sequence">1</field>
        </record>

        <record id="product_attribute_value_color_white" model="product.attribute.value">
            <field name="name">White</field>
