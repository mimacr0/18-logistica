<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Añadir campos de configuración al tipo de operación -->
    <record id="view_picking_type_form_custom_domain" model="ir.ui.view">
        <field name="name">stock.picking.type.form.custom.domain</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='second']" position="after">
                <group string="Dominios Personalizados" name="custom_domains">
                    <field name="use_custom_partner_domain"/>
                    <field name="allowed_location_ids" widget="many2many_tags"/>
                    <field name="allowed_location_dest_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
