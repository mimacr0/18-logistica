<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.BadgeSelectionField" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o_selection_badge')]" position="attributes">
            <attribute name="t-att-class">{
                'active': value === option[0],
                'btn-sm': props.size === 'sm',
                'btn-lg': props.size === 'lg'
            } + ' ' + getOptionClass(option[0])</attribute>
            <attribute name="class" add="" remove="btn-secondary" separator=" "/>
        </xpath>
    </t>
</templates>
