<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>


        <record id="quant_package_search_view_inh" model="ir.ui.view">
            <field name="name">quant.package.search.view.inh</field>
            <field name="model">stock.quant.package</field>
            <field name="inherit_id" ref="stock.quant_package_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group" position="after">
                    <searchpanel>
                        <field name="account_partner_id"/>
                    </searchpanel>
                </xpath>
            </field>
            
        </record>

        <record id="stock_reception_view_quant_package_list" model="ir.ui.view">
            <field name="name">stock.reception.view.quant.package.list</field>
            <field name="model">stock.quant.package</field>
            <field name="arch" type="xml">
                <list string="Package" sample="1" create="0">
                    <field name="display_name"/>

                    <field name="package_type_id"/>
                    <field name="carrier_id"/>
                    <field name="global_tracking_ref"/>
                    <field name="optional_tracking_ref"/>
                    <field name="weight"/>
                    <field name="account_partner_id" optional="hide"/>
                    <field name="location_id" options="{'no_create': True}" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="reception_hours" column_invisible="1"/>
                    <field name="reception_hours_label"
                        widget="badge"
                        decoration-success="reception_hours &gt;= 0 and reception_hours &lt; 24"
                        decoration-warning="reception_hours &gt; 24 and reception_hours &lt; 48"
                        decoration-danger="reception_hours &gt; 48"/>
                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'in_progress'" decoration-danger="state == 'with_incidence'"/>
                </list>
            </field>
        </record>

        <record id="action_view_quant_package" model="ir.actions.act_window">
            <field name="name">Packages</field>
            <field name="res_model">stock.quant.package</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="stock_reception_view_quant_package_list"/>
        </record>
    </data>
</odoo>