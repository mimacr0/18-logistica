<odoo>
    <data noupdate="1">
        <!-- Secuencia para stock.quant.package -->
        <record id="seq_stock_quant_package_custom" model="ir.sequence">
            <field name="name">Custom Stock Package Sequence</field>
            <field name="code">stock.quant.package.custom</field>
            <field name="prefix">%(y)s%(month)s%(day)s</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>