<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="resource_calendar_form_attendance" model="ir.ui.view">
        <field name="name">resource.calendar.form.attendance</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='resource_details']" position="after">
                <group string="Attendance Delay Settings" name="attendance_delay_settings">
                    <group>
                        <field name="allowed_entry_time" widget="float_time"/>
                        <field name="minor_delay_limit" widget="float_time"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
