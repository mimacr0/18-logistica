<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  Hr.attendance form view for adding delay_status field.  -->
    <record id="hr_attendance_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.view.form.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="before">
                <div style="display: flex; align-items: flex-start;" class="float-end">
                    <field name="delay_status" widget="badge" decoration-success="delay_status == 'on_time'" decoration-warning="delay_status == 'minor'" decoration-danger="delay_status == 'unjustified_abs'"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="hr_attendance_view_list_inherit" model="ir.ui.view">    
        <field name="name">hr.attendance.view.list.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='validated_overtime_hours']" position="after">
                <field name="delay_status" widget="badge" decoration-success="delay_status == 'on_time'" decoration-warning="delay_status == 'minor'" decoration-danger="delay_status == 'unjustified_abs'"/>
            </xpath>
        </field>
    </record>

    <!-- Server Action: Recalculate Delay Status (selected records) -->
    <record id="action_recalculate_delay_status" model="ir.actions.server">
        <field name="name">Recalculate Delay Status</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_recalculate_delay_status()
        </field>
    </record>

    <!-- Server Action: Recalculate ALL Delay Status -->
    <record id="action_recalculate_all_delay_status" model="ir.actions.server">
        <field name="name">Recalculate ALL Delay Status</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
env['hr.attendance'].action_recalculate_all_delay_status()
        </field>
    </record>
</odoo>
