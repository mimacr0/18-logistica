<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit the HR Attendance Settings view -->
    <record id="view_hr_attendance_config_settings" model="ir.ui.view">
        <field name="name">hr.attendance.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Insert our section in the HR Attendance settings -->
            <xpath expr="//block[@name='overtime_settings']" position="inside">
                <div class="app_settings_block" data-string="Attendance Delay Settings" string="Attendance Delay Settings">
                    <h2>Attendance Delay Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="delay_by_check_in"/>
                                <div class="text-muted">Delay hours depend on check-in time</div>
                                <field name="delay_by_check_in"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="allowed_entry_time_float"/>
                                <div class="text-muted">Allowed entry time (in hours, e.g. 9.5 = 9:30 AM)</div>
                                <div>
                                    <field name="allowed_entry_time_float" widget="float_time_selection"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="minor_delay_limit_float"/>
                                <div class="text-muted">Minor delay limit (e.g. 10.0 = 10:00 AM)</div>
                                <field name="minor_delay_limit_float" widget="float_time_selection"/>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="major_delay_limit_float"/>
                                <div class="text-muted">Major delay limit (e.g. 10.5 = 10:30 AM)</div>
                                <field name="major_delay_limit_float" widget="float_time_selection"/>
                            </div>
                        </div>

                       
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
