<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_inherited_companies_view" model="ir.ui.view">
        <field name="name">employee.inherited.companies.view</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group" position="inside">
                <field name="allowed_companies" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="employee_tracking_required_view" model="ir.ui.view">
        <field name="name">employee.tracking.required.view</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_attendance.view_employee_form_inherit_hr_attendance"/>
        <field name="priority">120</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attendance_manager_id']" position="after">
                <field name="tracking_required"/>
            </xpath>
        </field>
    </record>
</odoo>