<?xml version="1.0" encoding="UTF-8"?>
<!-- Template for the project dashboard -->
<templates id="AttendanceDashboard" xml:space="preserve">
    <t t-name="AttendanceDashboard">
        <div style="min-height:100vh; height:auto; max-height: -webkit-fill-available; overflow-y: scroll;">
            <div class="mx-5">
                <div class="row gx-0 mt-3">
                    <div class="col-12 d-flex justify-content-end ">
                        <!-- <button id="createCheckIn" t-on-click="(e) => this.createCheckIn(e)" class="btn btn-primary p-2">
                            <i class="fa fa-sign-in p-1" aria-hidden="true"></i> Check In
                        </button>
                        <button id="createBooking" t-on-click="(e) => this.createBooking(e)" class="btn btn-primary mx-2 p-2">
                            <i class="fa fa-plus p-1" aria-hidden="true"></i> Booking
                        </button> -->
                        <!-- <button id="downloadBtn" t-on-click="(e) => this.downloadReport(e)" class="btn btn-primary p-2">
                            <i class="fa fa-file-pdf-o p-1" aria-hidden="true"></i> Print
                        </button> -->
                    </div>
                </div>
            </div>
            <div class="mx-5" id="dashboard" >
                <t t-call="filters"/>
                <t t-call="attendance_counters"/>
                <t t-call="calender"/>
                <t t-call="table"/>
            </div>
        </div>
    </t>

    <t t-name="filters">
        <div class="card mt-4 mb-3 filters">
            <div class="row p-2 m-2 gx-0 gy-2" >  
                <div class="col-lg-5 pl-1 my-auto">
                    <h2> <t t-esc="greetings"/>, <t t-esc="state.user_name.value"/>.</h2>
                    <h4>Welcome to your Attendance Dashboard.</h4>
                </div>
                <div class="col-lg-7">  
                    <div class="row gy-2">
                        <div class="col-lg-3 m-0">
                            <label for="department_selection" class="form-label fw-bolder">Department:</label>
                            <select class="form-select" id="department_selection" t-on-change="(ev) => this._onchangeAttendanceFilter(ev)">
                                <option value="all">All Departments</option>
                            </select>
                        </div>
                        <div class="col-lg-3 m-0">
                            <label for="employee_selection" class="form-label fw-bolder">Employee:</label>
                            <select class="form-select" id="employee_selection" t-on-change="(ev) => this._onchangeAttendanceFilter(ev)">
                                <option value="all">All Employees</option>
                            </select>
                        </div>
                        <div class="col-lg-3 m-0">
                            <label for="month_selection" class="form-label fw-bolder">Month:</label>
                            <select class="form-select" id="month_selection" t-on-change="(ev) => this._onchangeAttendanceFilter(ev)">
                            </select>
                        </div>
                        <div class="col-lg-3 m-0">
                            <label for="year_selection" class="form-label fw-bolder">Year:</label>
                            <select class="form-select" id="year_selection" t-on-change="(ev) => this._onchangeAttendanceFilter(ev)">
                            </select>
                        </div>
                    </div>
                </div>        
                
                    <!-- </div>
                </div> -->
            </div>
        </div>
    </t>

    
    <t t-name="attendance_counters">
        <div class="mt-5 mb-1 alert alert-primary p-0" role="alert">
            <h2 class="m-0 p-2 text-primary">Today's Attendance Summary</h2>
        </div>
        <div class="row">
            <div class="col-lg-10">
                <div class="row mt-3 g-3">
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12">
                        <div class="stat-card" id="all_employee_data1" t-on-click="(e) => this.action_all_employees(e)" style="cursor: pointer; width:100%;">
                            <div class="stat1-contents1 d-flex justify-content-between align-items-center p-3">
                                <div>
                                    <h2>Employees</h2>
                                    <p class="stat-count"><t t-esc="this.state.all_employee_data.length" /></p>
                                </div>
                                <div class="adicons"><img t-att-src="'/dev_attendance_dashboard_advanced/static/src/image/total employess.svg'" /></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12">
                        <div class="stat-card" id="all_present1" t-on-click="(e) => this.action_all_employees(e)" style="cursor: pointer; width:100%;">
                            <div class="stat1-contents1 d-flex justify-content-between align-items-center p-3">
                            <div>
                                <h2> Presents</h2>
                                <p class="stat-count"><t t-esc="this.state.all_present_today.length" /></p>
                            </div>
                            <div class="adicons"><img t-att-src="'/dev_attendance_dashboard_advanced/static/src/image/present.svg'" /></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12">
                        <div class="stat-card" id="all_absent1" t-on-click="(e) => this.action_all_employees(e)" style="cursor: pointer; width:100%;">
                            <div class="stat1-contents1 d-flex justify-content-between align-items-center p-3">
                                <div>
                                    <h2> Absents</h2>
                                    <p class="stat-count"><t t-esc="this.state.all_absent_today.length" /></p>
                                </div>
                                <div class="adicons"><img t-att-src="'/dev_attendance_dashboard_advanced/static/src/image/absents.svg'" /></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12">
                        <div class="stat-card" id="on_leave1" t-on-click="(e) => this.action_all_employees(e)" style="cursor: pointer; width:100%;">
                            <div class="stat1-contents1 d-flex justify-content-between align-items-center p-3">
                                <div>
                                    <h2>On Leaves</h2>
                                    <p class="stat-count"><t t-esc="this.state.on_leave_today.length" /></p>
                                </div>
                                <div class="adicons"><img t-att-src="'/dev_attendance_dashboard_advanced/static/src/image/leave.svg'" /></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12">
                        <div class="stat-card" id="late_checkin1" t-on-click="(e) => this.action_all_employees(e)" style="cursor: pointer; width:100%;">
                            <div class="stat1-contents1 d-flex justify-content-between align-items-center p-3">
                                <div>
                                    <h2>Late Check-In</h2>
                                    <p class="stat-count"><t t-esc="this.state.late_checkin_today.length" /></p>
                                </div>
                                <div class="adicons"><img t-att-src="'/dev_attendance_dashboard_advanced/static/src/image/late check in.svg'" /></div>
                            </div>
                        </div>
                    </div>
                </div>    
            </div>
            <div class="col-xl-2 col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="mt-3">
                    
                    <div style="margin-top:0px;">
                        <button id="excel_download_btn"  class="btn btn-primary p-2 w-100" style="margin-bottom:10px; min-height:45px; max-width:100%;">
                            <i class="fa fa-file-pdf-o p-1" aria-hidden="true"></i> Download Attendance in Excel
                        </button>
                        
                        <button id="send_email_btn"  class="btn btn-primary p-2 w-100" style="min-height:45px; max-width:100%;">
                            <i class="fa fa-file-pdf-o p-1" aria-hidden="true"></i> Send Attendance Email
                        </button>

                    </div>
                </div>  
            </div> 
            
        </div>
    </t>
          
        

    <t t-name="calender">
        
        <div class="alert alert-primary mt-3" role="alert">
            <div class="row g-2 g-md-3">
                <div class="col-auto col-sm-auto col-md-auto col-lg-auto">
                    <div>[<b t-esc="this.getLegendP()"/> <t t-esc="this.getLegendPresent()"/>]</div>
                </div>
                <div class="col-auto col-sm-auto col-md-auto col-lg-auto">
                    <div>[<b t-esc="this.getLegendA()"/> <t t-esc="this.getLegendAbsent()"/>]</div>
                </div>
                <div class="col-auto col-sm-auto col-md-auto col-lg-auto">
                    <div>[<b t-esc="this.getLegendL()"/> <t t-esc="this.getLegendLeave()"/>]</div>
                </div>
                <div class="col-auto col-sm-auto col-md-auto col-lg-auto">
                    <div>[<b t-esc="this.getLegendH()"/> <t t-esc="this.getLegendHoliday()"/>]</div>
                </div>
                <div class="col-auto col-sm-auto col-md-auto col-lg-auto">
                    <div>[<b t-esc="this.getLegendMD()"/> <t t-esc="this.getLegendMinorDelay()"/>]</div>
                </div>
                <div class="col-auto col-sm-auto col-md-auto col-lg-auto">
                    <div>[<b t-esc="this.getLegendUA()"/> <t t-esc="this.getLegendUnjustifiedAbsence()"/>]</div>
                </div>
            </div>
        </div>
          
               
        <div class="card mt-3">
           <div class="table-responsive" style="overflow-x: auto;">
               <style>
                   /* Ocultar columnas de días en pantallas pequeñas, mantener empleado y resumen */
                   @media (max-width: 768px) {
                       /* Ocultar todas las columnas excepto la primera (empleado) y las últimas 6 (resumen: P, A, L, H, MD, UA) */
                       #attendanceCalender th:not(:first-child):not(:nth-last-child(-n+6)),
                       #attendanceCalender td:not(:first-child):not(:nth-last-child(-n+6)) {
                           display: none;
                       }
                   }
               </style>
               <table id="attendanceCalender" class="table table-bordered">
                    <thead>

                    </thead>
                    <tbody>
                        
                    </tbody>
               </table>
           </div>
        </div>
    </t>

    <t t-name="table">
        <div class="mt-5 mb-1 alert alert-primary p-0" role="alert">
            <h2 class="m-0 p-2 text-primary">Leave Summary</h2>
        </div>
        <div class="mb-5">
            <div class="card" style="border-radius:10px; overflow-x:auto;">
                <table id="leaveDetail" class="table">
                    <thead class="card-header">
                      <tr>
                        <th scope="col">Employee</th>
                        <th scope="col">Leave Type</th>
                        <th scope="col">From Date</th>
                        <th scope="col">To Date</th>
                        <th scope="col">Days</th>
                        <th scope="col">Description</th>
                        <th scope="col">State</th>
                        <th scope="col"></th>
                      </tr>
                    </thead>
                    <tbody>
                      
                    </tbody>
                </table>
                <t t-if="this.state.leave_summary.length != 0">
                    <div class="d-flex align-items-center justify-content-center text-primary m-2">
                        <i class="fa fa-arrow-circle-left fa-2x" aria-hidden="true" id='prev_button' t-on-click="(e) => this.prevPage(e)"> </i>
                        <span style="font-weight:600; font-size:15px; margin:0px 5px 0px 5px"> Page <t t-esc="this.state.currentPage"/> of <t t-esc="Math.ceil(this.state.leave_summary.length/this.state.rowsPerPage)"/> </span>
                        <i class="fa fa-arrow-circle-right fa-2x" id ='next_button' aria-hidden="true" t-on-click="(e) => this.nextPage(e)"> </i>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>