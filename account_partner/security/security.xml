<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category for Client Account groups -->
    <record id="module_category_account_partner" model="ir.module.category">
        <field name="name">Client Account</field>
        <field name="description">Grupos para gestión de cuentas de clientes</field>
        <field name="sequence">10</field>
    </record>

    <!-- Example group - modify as needed -->
    
    <record id="group_account_partner_user" model="res.groups">
        <field name="name">Account User</field>
        <field name="category_id" ref="module_category_account_partner"/>
        <field name="comment">User can view and manage client accounts</field>
    </record>

    <record id="group_account_partner_manager" model="res.groups">
        <field name="name">Account Manager</field>
        <field name="category_id" ref="module_category_account_partner"/>
        <field name="implied_ids" eval="[(4, ref('group_account_partner_user'))]"/>
        <field name="comment">Manager can configure and administer client accounts</field>
    </record>
   

</odoo>
