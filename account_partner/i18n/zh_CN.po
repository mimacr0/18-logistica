#. module: account_partner
#: model:mail.template,body_html:account_partner.email_template_delivery_carrier_confirmation
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear <t t-out=\"object.partner_id.name or ''\"/>,\n"
"        <br/><br/>\n"
"        Your order with number <strong t-out=\"object.name or ''\"/> has been confirmed. Please check your customer portal to continue with the process.\n"
"        <br/><br/>\n"
"\n"
"        You can track your order status and delivery details in your customer portal.\n"
"        <br/><br/>\n"
"        Regards,<br/>\n"
"        <t t-out=\"object.user_id.signature or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        亲爱的 <t t-out=\"object.partner_id.name or ''\"/>,\n"
"        <br/><br/>\n"
"        您的订单号 <strong t-out=\"object.name or ''\"/> 已确认。请检查您的客户门户以继续处理。\n"
"        <br/><br/>\n"
"        <strong>运输方式:</strong> <t t-out=\"object.carrier_id.name or ''\"/><br/>\n"
"        <t t-if=\"object.carrier_id.shipping_package\">\n"
"            <strong>包裹类型:</strong> <span t-field=\"object.carrier_id.shipping_package\"/><br/>\n"
"        </t>\n"
"        <br/>\n"
"        您可以在客户门户中跟踪订单状态和交付详情。\n"
"        <br/><br/>\n"
"        此致,<br/>\n"
"        <t t-out=\"object.user_id.signature or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

