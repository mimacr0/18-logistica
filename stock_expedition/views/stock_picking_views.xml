<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aplicar dominio de contactos permitidos en stock.picking -->
    <record id="view_picking_form_allowed_partners" model="ir.ui.view">
        <field name="name">stock.picking.form.allowed.partners</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="allowed_partner_ids" widget="many2many_tags" invisible="1"/>
            </xpath>
            <!-- Aplicar dominio a partner_id y mostrar dirección completa -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_partner_ids)] if allowed_partner_ids else []</attribute>
                <attribute name="context">{'show_address': 1}</attribute>
            </xpath>
            <xpath expr="//field[@name='carrier_id']" position="before">
                <field name="transport_insurance"></field>
            </xpath>
        </field>
    </record>
</odoo>
