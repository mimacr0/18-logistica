<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Añadir campo de filtro de direcciones de envío al tipo de operación -->
    <record id="view_picking_type_form_delivery_address" model="ir.ui.view">
        <field name="name">stock.picking.type.form.delivery.domain</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='second']" position="after">
                <group string="Filtros de Contactos" name="partner_filters">
                    <field name="use_delivery_address_domain"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
