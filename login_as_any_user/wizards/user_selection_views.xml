<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--wizard for user selection-->
    <record id="user_selection_view_form" model="ir.ui.view">
        <field name="name">user.selection.view.form</field>
        <field name="model">user.selection</field>
        <field name="arch" type="xml">
            <form string="Select User">
                <header invisible="1">
                    <field name="user_type" widget="statusbar" options="{'clickable': true}" statusbar_visible="portal"/>
                </header>
                <group invisible="user_type != 'manager'">
                    <field name="user_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                </group>
                <group invisible="user_type != 'portal'" colspan="6">
                    <div colspan="4" class="text-muted h2">
                        You're about to switch to user. Please note that the current session will be closed,
                        and a new session with: <field name="user_id" class="text-black oe_inline" nolabel="1" readonly="1" options="{'no_open': True}"/><br/>
                        Do you wish to continue?
                    </div>
                </group>
                <field name="access_ids" invisible="user_type != 'manager'"/>
                <footer>
                    <button name="action_switch" string="Switch User"
                            type="object" class="btn-primary" invisible="user_type != 'manager'"/>
                    <button string="Cancel" special="cancel"
                            class="btn-danger"/>
                    <button name="action_switch" string="Continue"
                            type="object" class="btn-success" invisible="user_type != 'portal'"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
