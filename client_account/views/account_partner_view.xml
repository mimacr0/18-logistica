<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_partner_view_list" model="ir.ui.view">
        <field name="name">account.partner.list</field>
        <field name="model">account.partner</field>
        <field name="arch" type="xml">
            <list string="Partners">
                <field name="name"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record id="action_account_partner" model="ir.actions.act_window">
        <field name="name">Account Partner</field>
        <field name="res_model">account.partner</field>
        <field name="view_mode">list,kanban,form</field>
<!--        <field name="search_view_id" ref="account_partner_view_search"/>-->
        <field name="context">{}</field>
        <field name="domain">[]</field>
    </record>

    <record id="action_account_partner_view_list" model="ir.actions.act_window.view">
        <field name="view_mode">list</field>
        <field name="view_id" ref="account_partner_view_list"/>
        <field name="act_window_id" ref="action_account_partner"/>
    </record>

</odoo>