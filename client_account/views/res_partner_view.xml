<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="client_account_view_form" model="ir.ui.view">
        <field name="name">account.partner.view.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Account Partners" create="0">
                <header>
                    <button id="invite_portal" name="portal.partner_wizard_action_create_and_open" string="Invite" type="action" class="btn-primary"
                            context="{'default_partner_id': uid}" invisible="email == False or state_account != 'no'" icon="fa-user-plus"/>
                    <button id="manage_portal" name="portal.partner_wizard_action_create_and_open" string="Manage Account" type="action" class="btn-secondary"
                            context="{'default_partner_id': uid}" invisible="state_account == 'no'" icon="fa-cog"/>
                    <field name="state_account" widget="statusbar"/>
                </header>
                <div class="alert alert-info" role="alert" invisible="email != False or state_account != 'no'">
                    You must add the e-mail address in the client in order to create your account.
                </div>
                <sheet>
                    <group>
                        <group>
                            <div class="oe_title mb24">
                                <label for="account" string="Account"/>
                                <h1>
                                    <field name="account" class="oe_inline"/>
                                </h1>
                            </div>
                        </group>
                        <group>
                            <div class="oe_title mb24" invisible="state_account == 'no'">
                                <label for="total_account" string="Account balance"/>
                                <h1>
                                    <field name="total_account" widget="monetary" options="{'currency_field': 'currency_id'}" reload="allways"/>
                                </h1>
                            </div>
                        </group>
                    </group>
                    <field name="account_id" invisible="1"/>
                    <group>
                        <group string="Account">
                            <field name="name" class="fw-bold" readonly="1"/>
                            <field name="email" widget="email" context="{'gravatar_image': True}" required="user_ids"/>
                            <field name="lang" invisible="active_lang_count &lt;= 1"/>
                            <label for="portal_user_ids" groups="base.group_no_one"/>
                            <div groups="base.group_no_one">
                                <field name="portal_user_ids" class="oe_inline" widget="many2many_tags" domain="[('parent_id', '=', id), ('type', '=', 'contact')]" options="{'no_create': True}"/>
                                <button name="check_portal_user_ids" type="object" string="Update" class="oe_link" invisible="1"/>
                            </div>
                        </group>
                        <group string="Information">
                            <field name="mobile" widget="phone"/>
                            <field name="phone" widget="phone"/>
                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color'}" placeholder="e.g. 'B2B', 'VIP', 'Consulting', ..."/>
                            <field name="user_id" widget="many2one_avatar_user" domain="[('share', '=', False)]"/>
                            <field name="currency_id" options="{'no_open': True}" invisible="1"/>
                        </group>
                    </group>
                    <group colspan="4">
                        <group>
                            <field name="credits" widget="monetary" options="{'currency_field': 'currency_id'}" class="h2" reload="allways"/>
                        </group>
                        <group>
                            <field name="sales" widget="monetary" options="{'currency_field': 'currency_id'}" class="h2" reload="allways"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Credits" id="credits_lines" invisible="credits == 0">
                            <field name="credit_account" nolabel="1" widget="product_label_section_and_note_field_o2m" mode="kanban">
                                <list string="Credits" editable="bottom" delete="0">
                                    <field name="name" readonly="1"/>
                                    <field name="date"/>
                                    <field name="concept"/>
                                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                </list>
                                <kanban class="o_kanban_mobile" records_draggable="0" create="false" group_create="0" display_unavailability="1" default_group_by="state">
                                    <field name="id"/>
                                    <field name="name"/>
                                    <field name="partner_account"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="currency_id"/>
                                    <field name="state"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="o_kanban_image">
                                                <h4><strong><field name="name"/></strong></h4>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-baseline mb-2">
                                                <field name="partner_account" class="fs-5"/>
                                                <div class="d-inline-flex align-items-baseline">
                                                    <i class="fa fa-money me-2" title="Amount"/>
                                                    <h4>
                                                        <field name="amount" widget="monetary" class="fw-bolder"/>
                                                    </h4>
                                                </div>
                                            </div>
                                            <div class="mb-2 card text-center">
                                                <field name="concept"/>
                                            </div>
                                            <footer class="align-items-end">
                                                <div class="d-flex flex-wrap gap-1 text-muted text-nowrap me-auto">
                                                    <i class="fa fa-calendar me-2" title="Date"/>
                                                    <field name="date"/>
                                                </div>
                                                <div class="ms-auto">
                                                    <field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'confirmed': 'success', 'rejected': 'warning'}}"/>
                                                </div>
                                            </footer>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Sales" id="sales_lines" invisible="sales == 0">
                            <field name="sale_order_ids" nolabel="1" widget="product_label_section_and_note_field_o2m" mode="kanban">
                                <kanban class="o_kanban_mobile" sample="1" quick_create="false">
                                    <field name="currency_id"/>
                                    <field name="partner_id"/>
                                    <field name="amount_total"/>
                                    <field name="date_order"/>
                                    <field name="activity_ids"/>
                                    <field name="state"/>
                                    <field name="name"/>
                                    <progressbar field="activity_state" colors="{&quot;planned&quot;: &quot;success&quot;, &quot;today&quot;: &quot;warning&quot;, &quot;overdue&quot;: &quot;danger&quot;}"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="d-flex justify-content-between align-items-baseline mb-2">
                                                <field name="partner_id" class="fw-bolder fs-5 me-2" context="{}"/>
                                                <div>
                                                    <field name="amount_total" widget="monetary" class="fw-bolder"/>
                                                </div>
                                            </div>
                                            <footer class="align-items-end">
                                                <div class="d-flex flex-wrap gap-1 text-muted text-nowrap me-auto">
                                                    <div>
                                                        <field name="name"/>
                                                    </div>
                                                    <div>
                                                        <field name="date_order"/>
                                                    </div>
                                                    <div>
                                                        <field name="activity_ids" widget="kanban_activity"/>
                                                    </div>
                                                </div>
                                                <div class="ms-auto">
                                                    <field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'cancel': 'default', 'sale': 'success'}}"/>
                                                </div>
                                            </footer>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="client_account_view_list" model="ir.ui.view">
        <field name="name">account.partner.view.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Partners" create="1" js_class="client_account_view_list_js" decoration-warning="state_account == 'no'" decoration-info="state_account == 'new'" decoration-success="state_account == 'active'">
                <field name="account"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_account" widget="monetary" options="{'currency_field': 'currency_id'}" class="h5"
                       decoration-danger="credits &lt; 50" decoration-info="credits &gt;= 50 and credits &lt; 1000" decoration-primary="credits &gt;= 1000" decoration-success="credits &gt; 2000"/>
                <field name="state_account"/>
            </list>
        </field>
    </record>

    <record id="action_partner_account" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'default_is_company': True}</field>
        <field name="domain">[('account','!=', False)]</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('client_account.client_account_view_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('base.res_partner_kanban_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('client_account.client_account_view_form')}),
            ]"/>
    </record>
</odoo>