#. module: client_account
#: model:mail.template,body_html:client_account.email_template_delivery_carrier_confirmation
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear <t t-out=\"object.partner_id.name or ''\"/>,\n"
"        <br/><br/>\n"
"        Your order with number <strong t-out=\"object.name or ''\"/> has been confirmed. Please check your customer portal to continue with the process.\n"
"        <br/><br/>\n"
"        <strong>Shipping Method:</strong> <t t-out=\"object.carrier_id.name or ''\"/><br/>\n"
"        <t t-if=\"object.carrier_id.shipping_package\">\n"
"            <strong>Package Type:</strong> <span t-field=\"object.carrier_id.shipping_package\"/><br/>\n"
"        </t>\n"
"        <br/>\n"
"        You can track your order status and delivery details in your customer portal.\n"
"        <br/><br/>\n"
"        Regards,<br/>\n"
"        <t t-out=\"object.user_id.signature or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Estimado <t t-out=\"object.partner_id.name or ''\"/>,\n"
"        <br/><br/>\n"
"        Su pedido con número <strong t-out=\"object.name or ''\"/> ha sido confirmado. Por favor, revise su portal de cliente para continuar con el proceso.\n"
"        <br/><br/>\n"
"        <strong>Método de envío:</strong> <t t-out=\"object.carrier_id.name or ''\"/><br/>\n"
"        <t t-if=\"object.carrier_id.shipping_package\">\n"
"            <strong>Tipo de paquete:</strong> <span t-field=\"object.carrier_id.shipping_package\"/><br/>\n"
"        </t>\n"
"        <br/>\n"
"        Puede rastrear el estado de su pedido y los detalles de entrega en su portal de cliente.\n"
"        <br/><br/>\n"
"        Saludos,<br/>\n"
"        <t t-out=\"object.user_id.signature or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

