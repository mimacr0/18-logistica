<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_form_rma_inventory" model="ir.ui.view">
        <field name="name">stock.quant.form.rma.inventory</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_form"/>
        <field name="arch" type="xml">
            <field name="owner_id" position="after">
                <field name="is_spare_parts" invisible="1"/>
                <field name="account_product_map_id"
                       options="{'no_create': True}"
                       domain="[('product_id.type', '!=', 'service'), ('is_spare_parts', '=', is_spare_parts)]"/>
            </field>
        </field>
    </record>

    <record id="view_stock_quant_list_rma_inventory" model="ir.ui.view">
        <field name="name">stock.quant.list.rma.inventory</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="is_spare_parts" column_invisible="1"/>
                <field name="account_product_map_id"
                       options="{'no_create': True}"
                       domain="[('product_id.type', '!=', 'service'), ('is_spare_parts', '=', is_spare_parts)]"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

        </field>
    </record>
</odoo>
