<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ubicaciones RMA provisionales (hijo de Stock principal); sustituir o archivar cuando exista diseño definitivo. -->
    
    <record id="stock_location_rma_customer_final" model="stock.location">
        <field name="name">RMA / End customer (package)</field>
        <field name="location_id" ref="stock.stock_location_customers"/>
        <field name="usage">customer</field>
    </record>
    <record id="stock_location_rma_reception" model="stock.location">
        <field name="name">RMA / Reception</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="usage">internal</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="stock_location_rma_unpack_zone" model="stock.location">
        <field name="name">RMA / Unpack zone</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="usage">internal</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="stock_location_rma_review" model="stock.location">
        <field name="name">RMA / Review</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="usage">internal</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="stock_location_rma_repair" model="stock.location">
        <field name="name">RMA / Repair</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="usage">internal</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="stock_location_rma_repair_department_warehouse" model="stock.location">
        <field name="name">Repair Department Warehouse</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="usage">internal</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="stock_location_rma_staging" model="stock.location">
        <field name="name">RMA / Provisional Stock Location</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="usage">internal</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="stock_location_rma_shipped" model="stock.location">
        <field name="name">RMA / Shipped (output)</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
        <field name="usage">internal</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
</odoo>
