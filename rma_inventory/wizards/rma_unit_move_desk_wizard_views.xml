<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rma_unit_move_desk_wizard_form" model="ir.ui.view">
        <field name="name">rma.unit.move.desk.wizard.form</field>
        <field name="model">rma.unit.move.desk.wizard</field>
        <field name="arch" type="xml">
            <form string="Move RMA units">
                <group>
                    <field name="location_dest_id" options="{'no_create': True}"
                           placeholder="Fill the destination location of all lines…"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="1">
                        <field name="rma_unit_id" readonly="1" force_save="1"/>
                        <field name="from_location_id" string="Source" readonly="1"/>
                        <field name="to_location_id" string="Destination" options="{'no_create': True}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm movement" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
